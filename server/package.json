{
  "name": "boostctc-voice-agent",
  "version": "1.0.0",
  "description": "BoostCTC voice agent — LangGraph TS + Vapi custom-LLM",
  "type": "module",
  "scripts": {
    "ingest": "tsx src/rag/ingest.ts",
    "dev": "tsx src/dev.ts",
    "server": "tsx --watch src/server/index.ts",
    "build": "tsc",
    "start": "node dist/server/index.js",
    "setup:vapi": "tsx src/setup_assistants.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@langchain/core": "^0.3.0",
    "@langchain/langgraph": "^0.2.0",
    "@langchain/openai": "^0.3.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "langsmith": "^0.5.20",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.21.0",
    "typescript": "^5.5.4"
  }
}
