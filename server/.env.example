# OpenAI
OPENAI_API_KEY=REDACTED_API_KEY

# Vapi
VAPI_PRIVATE_KEY=your-vapi-private-key-here
VAPI_PUBLIC_KEY=your-vapi-public-key-here

# Set after running: pnpm setup:vapi
VAPI_ASSISTANT_NEW_ID=
VAPI_ASSISTANT_RETURNING_ID=

# Your ngrok/prod URL that Vapi will call (no trailing slash)
VAPI_SERVER_URL=https://your-ngrok-url.ngrok.io

# Server port
PORT=3000

# LangSmith (optional but recommended)
LANGCHAIN_API_KEY=REDACTED_API_KEY
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=boostctc-voice
